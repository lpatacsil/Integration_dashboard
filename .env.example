# Integration Monitor - Environment Configuration
# Copy this file to .env and set your values

# ── Storage (Azure Blob Storage) ─────────────────────────────────────────────
# Local dev: run `docker compose up azurite` and use the Azurite well-known
# connection string below. In Azure, leave AZURE_STORAGE_CONNECTION_STRING unset
# and set AZURE_STORAGE_ACCOUNT_NAME instead — the Web App's managed identity
# authenticates via @azure/identity, no key/secret needed.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:12010/devstoreaccount1;
AZURE_STORAGE_CONTAINER=teamcentral-logs
# AZURE_STORAGE_ACCOUNT_NAME=

# ── Legacy / dormant: PostgreSQL (see database/migrations, api/src/db.ts) ────
# Not used by the API by default. Kept in case the storage backend is ever
# switched back via STORE_BACKEND=postgres once a postgres-store.ts exists.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=integration_monitor
DB_USER=integration_monitor
DB_PASSWORD=change_me_in_production
DB_SSL=false
POSTGRES_DB=integration_monitor
POSTGRES_USER=integration_monitor
POSTGRES_PASSWORD=change_me_in_production

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001

# ── NetSuite TBA (Token-Based Authentication) ───────────────────────────────
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=

# ── Notifications ────────────────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
